# Node & dependencies
node_modules/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
dist-ssr/
out/
build/
dist-electron/
.vite/
*.tsbuildinfo

# Release binaries (publish to GitHub Releases, never commit)
*.exe
*.msi
*.dmg
*.AppImage
*.blockmap

# Environment variables & secrets
.env
.env.*
!.env.example
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem
*.spc
*.pvk

# OS files
.DS_Store
Thumbs.db

# IDE & editors
.vscode/
.idea/
*.swp
*.swo

# Test & coverage
coverage/
.vitest/

# Playwright binaries cache
.playwright/

.vercel

# Workspaces install from the root lockfile only; nested lockfiles go stale.
apps/*/package-lock.json
packages/*/package-lock.json
scrape-output/

# Marketing renders, videos and carousels live in Desktop\Nomadic Content, never in the repo
brag-output*/
reel*/
showreel/
instagram-carousel/
marketing/
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.mp3
*.wav

# Tester builds are committed on purpose (Mac zips split under GitHub's 100 MB limit).
!tester-builds/**
