# -----------------------------------------------------------------------------
# Nomadic - Environment Variables
# Copy this file to `.env` (never commit `.env`) and fill in your values.
# Only SUPABASE_URL and SUPABASE_ANON_KEY are needed for normal development.
# -----------------------------------------------------------------------------

# -- Supabase cloud backend ----------------------------------------------------
# Needed for the cloud job feed, login/licensing and the session heartbeat.
# Leave blank to use the local scrapers only.
# Find these in: https://supabase.com -> your project -> Project Settings -> API
# Use the BASE project URL (no /rest/v1).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Same values for Vite-built frontends (desktop renderer and apps/web).
# Vite reads these from the process environment (scripts/windows/build-nomadic.ps1 sets them)
# or from a .env file in the app's own Vite root (apps/web/.env or
# apps/desktop/src/renderer/.env); they do not read this root file directly.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OPERATOR ONLY. Needed by the job pipeline (npm run scrape:publish) and seed
# scripts. Never ship it in a build, never put it in VITE_* vars. (Admin actions
# go through session-checked RPCs and do not use it.)
SUPABASE_SERVICE_ROLE_KEY=

# Job pipeline region: india (default) keeps jobs in India or remote-open-to-India; all keeps everything.
# SCRAPER_REGION=india

# -- AI ---------------------------------------------------------------------------
# No AI keys here. The Gemini key lives in Supabase Vault and is used only by the
# ai-proxy Edge Function; the desktop app never contains a model key.

# -- Google OAuth for the desktop app (optional) -------------------------------
# "Desktop app" OAuth client. The client id must also be in Vault as google_oauth_client_id.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -- Payments, updates, crash reports (optional, build time) -------------------
RAZORPAY_CHECKOUT_URL_PRO=
RAZORPAY_CHECKOUT_URL_MAX=
UPDATE_POLICY_URL=
SENTRY_DSN=

# -- Desktop app debugging (optional) ------------------------------------------
# Set to true to allow DevTools in a packaged build.
NOMADIC_ENABLE_DEVTOOLS=false

# -- Windows code signing (optional, used by scripts/windows/build-nomadic.ps1) ----------------
# Path to the .pfx (keep it OUTSIDE the repo) or the .pfx as a base64 string.
# When unset, builds are produced unsigned.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
# Alternative to a .pfx: SHA-1 thumbprint of a certificate in the Windows store.
WIN_CERT_THUMBPRINT=
# Set to 1 in release CI to fail the build instead of shipping unsigned binaries.
WIN_SIGN_REQUIRED=
