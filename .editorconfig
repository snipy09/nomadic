# Shared editor settings (VS Code, JetBrains, ...). Formatting rules live in .prettierrc.json.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows launchers must keep CRLF line ends.
[*.{cmd,bat,ps1,vbs}]
end_of_line = crlf

[*.{gradle,java,kt,xml}]
indent_size = 4
