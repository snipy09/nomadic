{
  "name": "nomadic-monorepo",
  "version": "1.0.6",
  "private": true,
  "description": "Nomadic — Commercial Grade Job Automator: High-Throughput Scrapers, Auto-Apply Engine, 4-Stage Email Verifier, Single-IP Security Desktop App",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:desktop",
    "test": "vitest run",
    "automation:run": "tsx packages/automation/src/index.ts",
    "automation:test": "tsx packages/automation/src/test-run.ts",
    "scrapers:run": "tsx packages/scrapers/src/index.ts",
    "scrapers:all": "tsx packages/scrapers/src/publish-all.ts",
    "scrapers:jobs": "tsx packages/scrapers/src/publish-jobs.ts",
    "scrapers:hrs": "tsx packages/scrapers/src/publish-hrs.ts",
    "scrapers:test": "tsx packages/scrapers/src/test-run.ts",
    "email:verify": "tsx packages/email-verifier/src/index.ts",
    "postinstall": "npx playwright install chromium",
    "build:desktop": "npm run build --prefix apps/desktop",
    "package:desktop": "npm run package:win --prefix apps/desktop",
    "dev:desktop": "npm run dev --prefix apps/desktop",
    "ui:dev": "npm run vite:dev --prefix apps/desktop",
    "start:desktop": "npm run start --prefix apps/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "npm run dev --prefix apps/web",
    "scrape:all": "npm run scrapers:all",
    "package:mac": "npm run package:mac --prefix apps/desktop",
    "bench:forms": "tsx packages/form-engine/src/bench-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "electron@28.3.3": true,
    "electron@31.7.7": true
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
