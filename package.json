{
  "name": "nomadic-monorepo",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "Nomadic — Commercial Grade Job Automator: High-Throughput Scrapers, Auto-Apply Engine, 4-Stage Email Verifier, Single-IP Security Desktop App",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @nomadic/desktop && npm run typecheck --workspace @nomadic/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:browsers": "playwright install chromium",
    "automation:run": "tsx packages/automation/src/index.ts",
    "automation:test": "tsx packages/automation/src/test-run.ts",
    "scrape": "tsx packages/scrapers/src/cli.ts",
    "scrape:publish": "tsx packages/scrapers/src/cli.ts run --publish",
    "scrapers:bench": "tsx packages/scrapers/src/cli.ts bench",
    "bench:forms": "tsx packages/form-bench/src/run.ts",
    "scrape:contacts": "tsx packages/scrapers/src/cli.ts contacts",
    "scrape:feed": "tsx packages/scrapers/src/cli.ts feed",
    "email:verify": "tsx packages/email-verifier/src/cli.ts",
    "build:desktop": "npm run build --prefix apps/desktop",
    "package:desktop": "npm run package:win --prefix apps/desktop",
    "dev:desktop": "npm run dev --prefix apps/desktop",
    "ui:dev": "npm run vite:dev --prefix apps/desktop",
    "start:desktop": "npm run start --prefix apps/desktop",
    "dev:web": "npm run dev --workspace @nomadic/web",
    "build:web": "npm run build --workspace @nomadic/web",
    "preview:web": "npm run preview --workspace @nomadic/web",
    "sign:win": "node scripts/sign-windows.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "electron@28.3.3": true,
    "electron@31.7.7": true
  },
  "dependencies": {
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
