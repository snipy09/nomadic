{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/download-setup", "destination": "https://github.com/snipy09/JobMaxxer/releases/download/v1.0.2/Nomadic.Setup.1.0.2.exe", "permanent": false },
    { "source": "/Nomadic-Setup-1.0.2.exe", "destination": "https://github.com/snipy09/JobMaxxer/releases/download/v1.0.2/Nomadic.Setup.1.0.2.exe", "permanent": false },
    { "source": "/Nomadic.Setup.1.0.2.exe", "destination": "https://github.com/snipy09/JobMaxxer/releases/download/v1.0.2/Nomadic.Setup.1.0.2.exe", "permanent": false },
    { "source": "/Nomadic-1.0.2.exe", "destination": "https://github.com/snipy09/JobMaxxer/releases/download/v1.0.2/Nomadic.1.0.2.exe", "permanent": false },
    { "source": "/Nomadic.1.0.2.exe", "destination": "https://github.com/snipy09/JobMaxxer/releases/download/v1.0.2/Nomadic.1.0.2.exe", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(png|ico|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
